# Copy to ops/.env on the host; never commit secrets.
# Docker Compose interpolates these for the optional Jellyfin profile.
TZ=America/New_York
JELLYFIN_LOCAL_PORT=8096
CINEMA_MEDIA_PATH=./media

# IMPORTANT: This file contains no Discord, Jellyfin admin, VPN, or DB secrets.
